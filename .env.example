# Copy via npm run env:init: generates local secrets, never overwrites .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
POSTGRES_USER=aljeel
POSTGRES_DB=aljeel
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
# Random secret, minimum 32 characters. Rotating it revokes cookie signatures.
SESSION_SECRET=
# Exactly 64 hexadecimal characters: AES-256-GCM for TOTP secrets.
TOTP_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOG_LEVEL=info
# False in A; becomes required for owners in F.
REQUIRE_OWNER_2FA=false
# TRUST_PROXY must only be enabled behind a trusted, isolated reverse proxy.
TRUST_PROXY=false
