# LiteSpeed / Apache configuration for Al-Jeel Al-Arabi Store
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve API endpoints with JSON header
  <FilesMatch "^(bootstrap|catalog|.*\.json)$">
    ForceType application/json
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # SPA Routing: Send all non-file/non-directory requests to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
