{
  "name": "lenis-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["packages/shared", "server", "admin"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "validate-data": "tsx scripts/validate-data.ts",
    "build": "tsx scripts/validate-data.ts && tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "dev": "vite --host 0.0.0.0",
    "dev:admin": "npm run dev -w @aljeel/admin",
    "dev:server": "npm run dev -w @aljeel/server",
    "build:all": "npm run build && npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "test": "npm run test -w @aljeel/server",
    "test:integration": "npm run test:integration -w @aljeel/server",
    "test:ui": "playwright test -c admin/playwright.config.ts",
    "db:generate": "npm run db:generate -w @aljeel/server",
    "db:migrate": "npm run db:migrate -w @aljeel/server",
    "seed:owner": "npm run seed:owner -w @aljeel/server",
    "env:init": "node scripts/admin/init-env.mjs",
    "dev:local": "node scripts/admin/local-dev.mjs",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/admin/local-postgres.ps1 -Action Stop"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "lucide-react": "^0.513.0",
    "motion": "^12.19.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.5",
    "@aljeel/shared": "*"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.57.0",
    "globals": "^16.5.0",
    "@playwright/test": "^1.63.0"
  }
}
