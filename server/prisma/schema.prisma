generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  manager
  sales
  editor
  viewer
}
enum Category {
  laptops
  displays
  audio
  gaming
  network
  storage
  power
}
enum Condition {
  new
  A
  B
  C
}
enum ContentStatus {
  draft
  published
  archived
}
enum Stock {
  in_stock
  low
  order
  sold
}
enum Shot {
  front_closed @map("front-closed")
  three_quarter_right @map("34-right")
  three_quarter_left @map("34-left")
  side
  open_screen @map("open-screen")
  keyboard
  ports_right @map("ports-right")
  ports_left @map("ports-left")
  back
  label
  defect
  accessories
}
enum BundleTier {
  economy
  balanced
  advanced
}
enum MediaKind {
  image
  sequence
  document
}
enum CustomerType {
  individual
  business
}
enum LeadSource {
  brief_builder
  quote_form
  contact_form
  product_inquiry
  whatsapp_click
  walk_in
  phone
  manual
}
enum LeadStatus {
  new
  contacted
  quoted
  won
  lost
}
enum ActivityType {
  note
  call
  whatsapp
  status_change
  assignment
}
enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}
enum Currency {
  USD
  YER
}
enum SubscriberChannel {
  email
  whatsapp
}
enum SubscriberStatus {
  active
  unsubscribed
  bounced
}
enum EventType {
  page_view
  product_view
  whatsapp_click
  filter_used
  compare_used
  search
  form_submit
  bundle_view
}
enum DeviceClass {
  mobile
  tablet
  desktop
}
enum Language {
  ar
  en
}

model User {
  id                 String @id @default(uuid()) @db.Uuid
  email              String @unique @db.VarChar(254)
  name               String @db.VarChar(100)
  nameSearch         String @default("") @db.VarChar(100)
  passwordHash       String
  role               Role
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(true)
  totpSecret         String?
  totpPendingSecret  String?
  totpPendingUntil   DateTime? @db.Timestamptz(3)
  totpLastCounter    BigInt?
  failedLogins       Int @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  auditLogs          AuditLog[]
  priceChanges       PriceHistory[]
  createdMedia       MediaAsset[]
  assignedLeads      Lead[]
  activities         LeadActivity[]
  @@index([role, isActive])
}
model Session {
  id        String @id @db.VarChar(64)
  userId    String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  userAgent String @db.VarChar(300)
  ipHash    String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}
model AuditLog {
  id        String @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  action    String @db.VarChar(80)
  entity    String @db.VarChar(80)
  entityId  String? @db.VarChar(100)
  before    Json? @db.JsonB
  after     Json? @db.JsonB
  // A keyed IP hash only, never a raw address.
  ip        String? @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}
model Brand {
  id                 String @id @default(uuid()) @db.Uuid
  slug               String @unique @db.VarChar(160)
  name               String @db.VarChar(160)
  description        Json @default("{}") @db.JsonB
  tagline            Json? @db.JsonB
  categories         Category[] @default([])
  logoMediaId        String? @db.Uuid
  isAuthorizedDealer Boolean @default(false)
  sort               Int @default(0)
  published          Boolean @default(false)
  logo               MediaAsset? @relation(fields: [logoMediaId], references: [id], onDelete: Restrict)
  products           Product[]
  @@index([published, sort])
}
model Product {
  id               String @id @default(uuid()) @db.Uuid
  slug             String @unique @db.VarChar(160)
  category         Category
  brandId          String @db.Uuid
  model            String @db.VarChar(200)
  title            Json @db.JsonB
  summary          Json @db.JsonB
  condition        Condition
  status           ContentStatus @default(draft)
  demo             Boolean @default(false)
  warrantyMonths   Int?
  priceUsd         Decimal? @db.Decimal(14, 2)
  priceYer         Decimal? @db.Decimal(18, 2)
  priceUpdatedAt   DateTime? @db.Timestamptz(3)
  negotiable       Boolean @default(false)
  stock            Stock @default(order)
  quantity         Int @default(0)
  serialNumber     String? @db.VarChar(200)
  batteryHealthPct Int?
  specs            Json @db.JsonB
  inspection       Json @db.JsonB
  specSources      String[] @default([])
  bestFor          String[] @default([])
  tags             String[] @default([])
  publishedAt      DateTime? @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  brand            Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  compatibleWith   ProductCompat[] @relation("compatSource")
  compatibleFrom   ProductCompat[] @relation("compatTarget")
  priceHistory     PriceHistory[]
  bundleItems      BundleItem[]
  leads            Lead[]
  quoteItems       QuoteItem[]
  sales            Sale[]
  events           AnalyticsEvent[]
  @@index([status, deletedAt, category, publishedAt])
  @@index([brandId, status])
  @@index([stock, deletedAt])
  @@index([demo, deletedAt])
}
model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  mediaId   String @db.Uuid
  sort      Int @default(0)
  shot      Shot
  altAr     String @default("")
  altEn     String @default("")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@unique([productId, mediaId])
  @@index([productId, sort])
  @@index([mediaId])
}
model ProductCompat {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @db.Uuid
  otherProductId String @db.Uuid
  portType       String?
  watts          Decimal? @db.Decimal(10, 2)
  verified       Boolean @default(false)
  source         String?
  note           String?
  product        Product @relation("compatSource", fields: [productId], references: [id], onDelete: Cascade)
  otherProduct   Product @relation("compatTarget", fields: [otherProductId], references: [id], onDelete: Restrict)
  @@unique([productId, otherProductId])
  @@index([otherProductId])
}
model PriceHistory {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  priceUsd  Decimal? @db.Decimal(14, 2)
  priceYer  Decimal? @db.Decimal(18, 2)
  changedBy String @db.Uuid
  changedAt DateTime @default(now()) @db.Timestamptz(3)
  reason    String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  @@index([productId, changedAt])
  @@index([changedBy])
}
model Bundle {
  id             String @id @default(uuid()) @db.Uuid
  slug           String @unique @db.VarChar(160)
  useCase        String @db.VarChar(80)
  title          Json @db.JsonB
  summary        Json @db.JsonB
  why            Json @db.JsonB
  problemSolved  Json @db.JsonB
  tiers          Json @db.JsonB
  published      Boolean @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  items          BundleItem[]
  @@index([published, useCase])
}
model BundleItem {
  id        String @id @default(uuid()) @db.Uuid
  bundleId  String @db.Uuid
  tier      BundleTier
  productId String? @db.Uuid
  roleLabel Json? @db.JsonB
  qty       Int @default(1)
  sort      Int @default(0)
  bundle    Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([bundleId, tier, sort])
  @@index([productId])
}
model FaqItem {
  id        String @id @default(uuid()) @db.Uuid
  question  Json @db.JsonB
  answer    Json @db.JsonB
  sort      Int @default(0)
  published Boolean @default(false)
  category  String? @db.VarChar(80)
  @@index([published, category, sort])
}
model WarrantyPolicy {
  id                   Int @id @default(1)
  conditionGrades      Json @db.JsonB
  inspectionChecklist  Json @db.JsonB
  policy               Json @db.JsonB
  newMonths            Int?
  gradeAMonths         Int?
  gradeBMonths         Int?
  gradeCMonths         Int?
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
}
model Guide {
  id           String @id @default(uuid()) @db.Uuid
  slug         String @unique @db.VarChar(160)
  title        Json @db.JsonB
  body         Json @db.JsonB
  coverMediaId String? @db.Uuid
  tags         String[] @default([])
  status       ContentStatus @default(draft)
  publishedAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  cover        MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: Restrict)
  @@index([status, publishedAt])
}
model SiteSetting {
  key       String @id @db.VarChar(100)
  value     Json @db.JsonB
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
model MediaAsset {
  id           String @id @default(uuid()) @db.Uuid
  kind         MediaKind
  originalPath String
  variants     Json @db.JsonB
  manifest     Json? @db.JsonB
  width        Int?
  height       Int?
  bytes        BigInt
  sourceNote   String?
  licensed     Boolean @default(false)
  altAr        String @default("")
  altEn        String @default("")
  createdBy    String @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  creator      User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  productImages ProductImage[]
  brands       Brand[]
  guides       Guide[]
  @@index([kind, createdAt])
  @@index([createdBy])
}
model Customer {
  id               String @id @default(uuid()) @db.Uuid
  name             String? @db.VarChar(150)
  phone            String? @db.VarChar(16)
  email            String? @db.VarChar(254)
  city             String? @db.VarChar(100)
  type             CustomerType @default(individual)
  company          String?
  notes            String?
  tags             String[] @default([])
  firstSource      LeadSource
  marketingConsent Boolean @default(false)
  consentAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)
  leads            Lead[]
  quotes           Quote[]
  sales            Sale[]
  @@index([phone])
  @@index([deletedAt, createdAt])
}
model Lead {
  id             String @id @default(uuid()) @db.Uuid
  customerId     String? @db.Uuid
  source         LeadSource
  status         LeadStatus @default(new)
  lostReason     String?
  payload        Json @db.JsonB
  productId      String? @db.Uuid
  assignedToId   String? @db.Uuid
  nextFollowUpAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  assignedTo     User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  quotes         Quote[]
  @@index([status, createdAt])
  @@index([assignedToId, nextFollowUpAt])
  @@index([source, createdAt])
  @@index([customerId])
  @@index([productId])
}
model LeadActivity {
  id        String @id @default(uuid()) @db.Uuid
  leadId    String @db.Uuid
  userId    String @db.Uuid
  type      ActivityType
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([leadId, createdAt])
  @@index([userId])
}
model Quote {
  id         String @id @default(uuid()) @db.Uuid
  leadId     String? @db.Uuid
  customerId String? @db.Uuid
  currency   Currency @default(USD)
  subtotal   Decimal @db.Decimal(18, 2)
  discount   Decimal @default(0) @db.Decimal(18, 2)
  total      Decimal @db.Decimal(18, 2)
  validUntil DateTime? @db.Timestamptz(3)
  status     QuoteStatus @default(draft)
  notes      Json? @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      QuoteItem[]
  @@index([status, createdAt])
  @@index([customerId])
  @@index([leadId])
}
model QuoteItem {
  id        String @id @default(uuid()) @db.Uuid
  quoteId   String @db.Uuid
  productId String? @db.Uuid
  label     Json @db.JsonB
  qty       Int @default(1)
  unitPrice Decimal @db.Decimal(18, 2)
  currency  Currency
  sort      Int @default(0)
  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([quoteId, sort])
  @@index([productId])
}
model Sale {
  id             String @id @default(uuid()) @db.Uuid
  customerId     String? @db.Uuid
  productId      String? @db.Uuid
  serialNumber   String?
  soldAt         DateTime @default(now()) @db.Timestamptz(3)
  priceUsd       Decimal? @db.Decimal(14, 2)
  warrantyMonths Int?
  warrantyStart  DateTime @db.Timestamptz(3)
  warrantyEnd    DateTime? @db.Timestamptz(3)
  notes          String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([warrantyEnd])
  @@index([customerId, soldAt])
  @@index([productId])
}
model Subscriber {
  id                 String @id @default(uuid()) @db.Uuid
  channel            SubscriberChannel
  contact            String @db.VarChar(254)
  status             SubscriberStatus @default(active)
  consentAt          DateTime @db.Timestamptz(3)
  consentSource      String @db.VarChar(100)
  consentTextVersion String @db.VarChar(80)
  unsubscribeToken   String @unique @db.VarChar(64)
  tags               String[] @default([])
  lang               Language @default(ar)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  @@unique([channel, contact])
  @@index([channel, status, createdAt])
}
model AnalyticsEvent {
  id           String @id @default(uuid()) @db.Uuid
  type         EventType
  path         String @db.VarChar(500)
  productId    String? @db.Uuid
  visitorHash  String @db.VarChar(64)
  sessionHash  String @db.VarChar(64)
  referrerHost String? @db.VarChar(254)
  utm          Json? @db.JsonB
  deviceClass  DeviceClass
  lang         Language
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([visitorHash, createdAt])
}
model AnalyticsDaily {
  id          String @id @default(uuid()) @db.Uuid
  day         DateTime @db.Date
  type        EventType
  // Stable hash of dimension JSON; no visitor identifiers retained.
  dimensionKey String @db.VarChar(64)
  dimensions   Json @db.JsonB
  events       Int @default(0)
  visitors     Int @default(0)
  @@unique([day, type, dimensionKey])
  @@index([day, type])
}
